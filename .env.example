# Copy to .env.local and fill in from your Supabase project (Settings → API).

# Required. Project URL and publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Strongly recommended. Lets the server create accounts that are confirmed
# immediately (no confirmation email). Server-only, never shipped to the browser.
# Without it, turn off "Confirm email" under Authentication → Providers → Email.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Comma-separated emails that become admin the moment they sign up.
# (The very first account to sign up is made admin automatically anyway.)
ADMIN_EMAILS=you@example.com
