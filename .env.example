# Copy to .env.local and fill in from the Supabase dashboard (Settings → API).
#
# Krillion shares its Supabase project with Arena Tracker (project ref
# jogqfqzhsoxomuozxasd), so the URL and the publishable/anon key are the SAME
# values Arena Tracker uses (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).

# Required. Project URL and publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://jogqfqzhsoxomuozxasd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Strongly recommended. Lets the server create accounts that are confirmed
# immediately (no confirmation email). Server-only, never shipped to the browser.
# Do NOT turn off "Confirm email" in the dashboard instead: that is a
# project-wide Auth setting and would also disable it for Arena Tracker.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Comma-separated emails that become admin the moment they sign up.
# (The first account to use this site, and anyone in Arena Tracker's app_admins
# table, is made admin automatically anyway.)
ADMIN_EMAILS=
